<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Duo Mac</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Where this Mac's Duo Mac page is (its Tailscale address), filled in by tools/ios-app.sh. -->
	<key>DuoMacURL</key>
	<string>$(DUO_MAC_URL)</string>
	<!-- The page's own address: lets it keep its offline copy (service worker) inside the app. -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>$(DUO_MAC_HOST)</string>
		<!-- Your other Macs on the tailnet (Settings › Macs): any name under it. -->
		<string>$(DUO_TAILNET)</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Scans the pairing QR code shown by Duo Mac on your Mac.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID unlocks your Mac.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Your iPhone's microphone can be your Mac's microphone.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Dictation turns what you say into text typed on your Mac.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Duo Mac connects straight to your Mac when it's on the same Wi-Fi or on this iPhone's hotspot.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Lets the app draw at 120 Hz on ProMotion iPhones (the Mac's screen, NativeVideo.swift). -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
